# API
API_PORT=8000
RIA_APP_NAME=Regulatory Intelligence Assistant
RIA_ENVIRONMENT=development
RIA_LOG_LEVEL=INFO
RIA_MINIMUM_QUERY_COVERAGE=0.60
RIA_MAX_RESULTS=5

# Optional LLM-as-a-judge evaluation (never required by the production API)
# GEMINI_API_KEY=replace-with-your-key
RIA_GEMINI_MODEL=gemini-3.6-flash
RIA_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RIA_GEMINI_EMBEDDING_DIMENSIONS=768
RIA_GEMINI_CACHE_DIR=artifacts/gemini-cache
RIA_GEMINI_MAX_ATTEMPTS=3
RIA_GEMINI_BACKOFF_SECONDS=1.0

# PostgreSQL
POSTGRES_DB=regulatory
POSTGRES_USER=regulatory
# Replace this value outside local development.
POSTGRES_PASSWORD=regulatory
POSTGRES_PORT=5432

# Observability
PROMETHEUS_PORT=9090
